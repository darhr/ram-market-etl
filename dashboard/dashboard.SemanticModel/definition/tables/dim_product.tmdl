	column 'Product Label' = ```
			
			dim_product[brand] & " " & 
			COALESCE(dim_product[series] & " ", "") & 
			dim_product[capacity_gb] & "GB DDR" & 
			dim_product[ddr_gen] & " " & 
			dim_product[speed_mts] & "MT/s" &
			IF(dim_product[kit_modules] > 1, " (" & dim_product[kit_modules] & "x" & (dim_product[capacity_gb] / dim_product[kit_modules]) & "GB)", "") &
			IF(dim_product[has_rgb], " RGB", "")
			```
		lineageTag: 0d056c52-a400-4ba7-aeab-9472fabcbd1e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_product = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("ep-lucky-sun-acqiy3kt-pooler.sa-east-1.aws.neon.tech", "ram_scraper"), "SELECT id, brand, series, capacity_gb, speed_mts, ddr_gen, kit_modules, has_rgb, part_number#(lf)FROM silver.product", null, [EnableFolding=true])
				in
				    Source

