	column is_outlier = ```
			
			VAR vCurrentPrice = fact_price[price]
			VAR vCurrentDDR = RELATED(dim_product[ddr_gen])
			
			VAR vMedianaDDR = 
			    CALCULATE(
			        MEDIAN(fact_price[price]),
			        ALL(fact_price),
			        dim_product[ddr_gen] = vCurrentDDR
			    )
			
			RETURN
			    IF(
			        ISBLANK(vCurrentPrice) || vCurrentPrice <= 0 ||
			        vCurrentPrice > (vMedianaDDR * 5) || 
			        vCurrentPrice < (vMedianaDDR * 0.3),
			        TRUE(),
			        FALSE()
			    )
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: dc24c04c-b96b-415b-9954-68097fafdbbe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_price = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database("ep-lucky-sun-acqiy3kt-pooler.sa-east-1.aws.neon.tech", "ram_scraper"), "SELECT ps.product_id, ps.store_id, ps.etl_run_id, ps.price, ps.currency,#(lf)       ps.valid_from, ps.valid_to, ps.is_current,#(lf)       DATE(ps.valid_from) AS valid_date#(lf)FROM silver.price_snapshot ps", null, [EnableFolding=true])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

