# Tech Market Sentinel — Environment variables template
# Copy to .env.development or .env.production and fill in real values.
# This file is committed to git. Real env files are gitignored.

# Google Sheets CSV (public, no auth)
BRAND_SERIES_MAP_URL="<public-csv-url>"
SERIES_ALIASES_MAP_URL="<public-csv-url>"

# PostgreSQL connection string
DATABASE_URL="postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>"

# Cloudflare R2 (S3-compatible)
# Endpoint must be the account-level URL, NEVER include the bucket name.
R2_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="<bucket-name>"
R2_ACCESS_KEY_ID="<r2-token-access-key>"
R2_SECRET_ACCESS_KEY="<r2-token-secret>"

# Environment: "development" or "production"
# Controls whether the local CSV fallback (data/raw_data.csv) is written.
ENVIRONMENT="development"
